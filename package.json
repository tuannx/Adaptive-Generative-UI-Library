{
  "name": "adaptive-generative-ui-library",
  "private": true,
  "version": "0.1.0",
  "description": "Adaptive Generative UI Library - OpenAPI to React UI for AI Agents",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "swarm:status": "node scripts/swarm-status.mjs",
    "swarm:next": "node scripts/swarm-next.mjs",
    "swarm:bootstrap": "node scripts/swarm-bootstrap.mjs",
    "clean": "rm -rf packages/*/dist apps/demo/dist node_modules/.cache"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "turbo": "^2.5.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  }
}
