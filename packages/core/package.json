{
  "name": "@agul/core",
  "version": "0.1.0",
  "description": "OpenAPI parser and route generator for AGUL",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "openapi",
    "swagger",
    "parser",
    "generator",
    "api",
    "typescript",
    "agul"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuannx/Adaptive-Generative-UI-Library.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.build.json",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint": "vp lint src"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plus": "1.5.0"
  },
  "homepage": "https://tuannx.github.io/Adaptive-Generative-UI-Library/",
  "bugs": {
    "url": "https://github.com/tuannx/Adaptive-Generative-UI-Library/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
