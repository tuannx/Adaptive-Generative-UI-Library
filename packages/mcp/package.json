{
  "name": "@aikitstudio/agul-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing AGUL OpenAPI-to-UI tools for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agul-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.build.json",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@aikitstudio/agul-core": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "1.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuannx/Adaptive-Generative-UI-Library.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "openapi",
    "agent",
    "generative-ui",
    "agul"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://tuannx.github.io/Adaptive-Generative-UI-Library/",
  "bugs": {
    "url": "https://github.com/tuannx/Adaptive-Generative-UI-Library/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
