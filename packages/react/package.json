{
  "name": "@agul/react",
  "version": "0.1.0",
  "description": "React components and AGULRenderer for OpenAPI-driven dynamic UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "keywords": [
    "react",
    "openapi",
    "swagger",
    "ui",
    "admin",
    "crud",
    "ant-design",
    "agul"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuannx/Adaptive-Generative-UI-Library.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "antd": "^5.0.0",
    "axios": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "swr": "^2.0.0"
  },
  "dependencies": {
    "@agul/core": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "axios": "^1.13.2",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
