{
  "name": "@agul/react",
  "version": "0.1.0",
  "description": "React components and AGULRenderer for OpenAPI-driven dynamic UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "openapi",
    "swagger",
    "ui",
    "admin",
    "crud",
    "ant-design",
    "agul"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuannx/Adaptive-Generative-UI-Library.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.build.json",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint src"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.0.0 || ^6.0.0",
    "antd": "^5.0.0",
    "axios": "^1.0.0",
    "dayjs": "^1.11.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "swr": "^2.0.0"
  },
  "dependencies": {
    "@agul/core": "0.1.0",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "axios": "^1.13.2",
    "dayjs": "^1.11.13",
    "typescript": "^7.0.2",
    "vite-plus": "1.5.0"
  },
  "homepage": "https://tuannx.github.io/Adaptive-Generative-UI-Library/",
  "bugs": {
    "url": "https://github.com/tuannx/Adaptive-Generative-UI-Library/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
