{
  "name": "@agul/demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && wrangler types worker/worker-configuration.d.ts --check && tsc --noEmit -p worker",
    "lint": "eslint src",
    "build:cloudflare": "vite build --mode cloudflare",
    "test": "vitest run",
    "cf:dev": "npm run build:cloudflare && wrangler dev",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "cf:types": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@agul/core": "0.1.0",
    "@agul/react": "0.1.0",
    "@ant-design/icons": "^5.6.1",
    "@anthropic-ai/sdk": "^1.3.0",
    "antd": "^5.28.1",
    "axios": "^1.13.2",
    "dayjs": "^1.11.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "swr": "^2.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.154.0"
  }
}
