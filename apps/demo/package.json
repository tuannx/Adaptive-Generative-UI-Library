{
  "name": "@ai-kit/agul-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit && wrangler types worker/worker-configuration.d.ts --check && tsc --noEmit -p worker",
    "lint": "vp lint src",
    "build:cloudflare": "vp build --mode cloudflare",
    "test": "vp test run",
    "cf:dev": "npm run build:cloudflare && wrangler dev",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "cf:types": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@ai-kit/agul-core": "0.1.0",
    "@ai-kit/agul-react": "0.1.0",
    "@ant-design/icons": "^6.3.4",
    "@anthropic-ai/sdk": "^1.3.0",
    "antd": "^6.7.0",
    "axios": "^1.13.2",
    "dayjs": "^1.11.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "swr": "^2.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "wrangler": "^4.154.0"
  }
}
